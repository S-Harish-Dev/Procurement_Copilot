# Copy to .env with `make env` (fills every secret below with fresh random values).
# .env is gitignored — never commit real keys.

# --- LLM providers (free tiers; fallback order Groq -> Gemini -> OpenRouter) ---
# Each *_API_KEY accepts one key or several comma-separated (key1,key2,...), rotated round-robin.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Which provider file the gateway loads: providers.toml (real) or providers.mock.toml (offline mock-llm).
PROVIDERS_TOML=gateway/providers.toml
# Key the gateway sends to the local mock-llm (any non-empty value).
MOCK_LLM_KEY=mock

# --- TypeSafe Jev (router + relevance gate). Only PII-masked text is ever sent. ---
TYPESAFE_API_KEY=
# Public OpenAPI lists only the aliases jev-latest / jev-preview; pin a version once a key confirms one.
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai
# Offline compose: JEV_BASE_URL=http://mock-jev:8090 and TYPESAFE_API_KEY=mock (the native stack does this itself).
# Jev spend cap in USD; the gateway warns at 80% and degrades at 95%.
JEV_BUDGET_USD=5.00

# --- Hugging Face (Prompt Guard 2 is gated under the Llama license) ---
HF_TOKEN=

# --- Local infrastructure (defaults match infra/docker-compose.yml) ---
POSTGRES_USER=acme
POSTGRES_PASSWORD=
POSTGRES_DB=procurement
DATABASE_URL=
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334
VALKEY_PASSWORD=
VALKEY_URL=
OPA_URL=http://localhost:8181
BRAIN_URL=http://localhost:50051
OTEL_EXPORTER_OTLP_ENDPOINT=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Secrets generated by `make env` ---
# AES-256-GCM key for vendor PII and chunk originals at rest (32 random bytes, base64).
PII_ENCRYPTION_KEY=
# HMAC key for one-time action confirmation tokens (shared by gateway and MCP servers).
CONFIRMATION_HMAC_KEY=
# Shared token the brain presents to the gateway's internal LLM proxy (:8081).
INTERNAL_API_TOKEN=
# RS256 key pair for user and on-behalf-of JWTs (created by `make keys`).
JWT_PRIVATE_KEY=infra/keys/jwt-private.pem
JWT_PUBLIC_KEY=infra/keys/jwt-public.pem
